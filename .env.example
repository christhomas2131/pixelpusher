# Signing & notarization for macOS distribution builds.
# Copy this file to .env (or set in CI secrets) and fill in. Do NOT commit .env.
#
# Pick ONE of the three credential modes for notarization. App Store Connect
# API key is the recommended choice for CI (no 2FA prompts, easier rotation).

# ── Mode 1: App Store Connect API key (recommended for CI) ────────────────────
# Generate at https://appstoreconnect.apple.com/access/api
# APPLE_API_KEY=/path/to/AuthKey_XXXXXXXXXX.p8
# APPLE_API_KEY_ID=XXXXXXXXXX
# APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000

# ── Mode 2: App-specific password ─────────────────────────────────────────────
# Generate at https://appleid.apple.com/account/manage → "App-Specific Passwords"
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=YOURTEAMID

# ── Mode 3: Keychain profile (local dev) ──────────────────────────────────────
# Run: xcrun notarytool store-credentials "AC_PROFILE" --apple-id ... --team-id ...
# APPLE_KEYCHAIN=/Users/you/Library/Keychains/login.keychain-db
# APPLE_KEYCHAIN_PROFILE=AC_PROFILE

# ── Code-signing certificate ──────────────────────────────────────────────────
# Either point CSC_LINK at a .p12 (base64 or path) and set CSC_KEY_PASSWORD,
# or rely on the keychain having "Developer ID Application: <Name> (<TeamID>)"
# CSC_LINK=/path/to/cert.p12
# CSC_KEY_PASSWORD=your_p12_password
# CSC_NAME="Developer ID Application: Your Name (TEAMID)"

# When the above are set:
#   1. Edit electron-builder.yml: identity: <your cert name or remove for auto>
#                                  hardenedRuntime: true
#                                  notarize: true
#   2. Run: npm run dist
#   3. Verify: codesign --verify --deep --strict --verbose=2 release/mac-universal/PixelPusher.app
#              spctl --assess --type execute --verbose release/mac-universal/PixelPusher.app
#              xcrun stapler validate release/PixelPusher-1.0.0-universal.dmg

# ── Crash reporting (Sentry) ──────────────────────────────────────────────────
# Optional. When set, the main process initializes @sentry/electron at startup
# and the renderer attaches automatically over IPC. Stack traces only —
# sendDefaultPii is off and home-directory paths are redacted before send.
# Leave unset for local dev to keep events out of your project quota.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
