{
  "name": "pixelpusher",
  "version": "1.0.0",
  "description": "Photo and video library organizer",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n main,renderer,electron \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "dev:electron": "node scripts/dev-electron.js",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "ensure:mac-arches": "node scripts/ensure-mac-arches.js",
    "predist": "npm run ensure:mac-arches",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "icons": "npx electron scripts/generate-icons.js",
    "stress:ladder": "node scripts/_run-stress.cjs scripts/stress-ladder.ts",
    "smoke": "node scripts/_run-stress.cjs scripts/smoke-test.ts",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo 'electron-rebuild skipped (no build tools)'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.3",
    "exiftool-vendored": "^35.19.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.33.3"
  },
  "overrides": {
    "@electron/asar": "~4.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "concurrently": "^8.2.2",
    "css-loader": "^6.10.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "html-webpack-plugin": "^5.6.0",
    "sql.js": "^1.14.1",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
